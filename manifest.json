{
  "id": "/",
  "name": "SkyCast Weather",
  "short_name": "SkyCast",
  "description": "Live US weather from the National Weather Service: hourly and 14-day forecasts, live and future radar, severe weather warnings, a Snow Day Predictor, holiday travel forecasts and daily weather news.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b1424",
  "theme_color": "#0b1424",
  "categories": ["weather", "utilities", "news"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Radar", "short_name": "Radar", "description": "Open the live and future radar", "url": "./#radar", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Weather news", "short_name": "News", "description": "Read today's weather news", "url": "./#news", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
